{
  "name": "ncu-gift-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run check:i18n",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
}
