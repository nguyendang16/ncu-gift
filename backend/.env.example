# Copy this file to backend/.env and fill in the key. backend/.env is git-ignored; never commit a real key.
OPENAI_API_KEY=
# Model: gpt-6-luna supports the Chat Completions API used here (see its page on developers.openai.com).
NCU_GIFT_LLM_MODEL=gpt-6-luna
# How hard the model thinks before answering: none | low | medium | high | xhigh | max.  "low" is plenty for summaries.
NCU_GIFT_LLM_REASONING=low
# Safety valve: the most AI requests per day (all features together).
NCU_GIFT_AI_DAILY_CAP=1000
# A key in this file switches AI on for the whole app. Set to 0 to require the per-feature switches instead.
NCU_GIFT_AI_CONSENT=1
# Set to 1 to try the screens with canned replies and no key (clearly labelled "demo" in the interface).
NCU_GIFT_AI_DEMO=0
